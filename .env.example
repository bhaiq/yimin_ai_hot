# The existing single-key setting remains supported. Add fallback keys either as
# a comma-separated list or as FIRECRAWL_API_KEY_2, FIRECRAWL_API_KEY_3, etc.
FIRECRAWL_API_KEY=
FIRECRAWL_API_KEYS=
# Website sources use a dedicated Firecrawl queue. Keep this at 8 or 9 to stay
# below the default per-minute API limit. HTTP 429 responses wait and retry.
FIRECRAWL_REQUESTS_PER_MINUTE=8
FIRECRAWL_MAX_RATE_LIMIT_RETRIES=3
FIRECRAWL_RETRY_JITTER_MS=1500

